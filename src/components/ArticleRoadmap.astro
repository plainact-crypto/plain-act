---
const stages = [
  ['01', 'Understand'],
  ['02', 'Clarify'],
  ['03', 'Delegate'],
  ['04', 'Correct']
];
---
<nav class="article-roadmap" aria-label="First 30 days roadmap">
  {stages.map(([number, label]) => (
    <div class="roadmap-stage">
      <span class="roadmap-number">{number}</span>
      <span class="roadmap-label">{label}</span>
    </div>
  ))}
</nav>

<style>
  .article-roadmap {
    width: min(100%, 980px);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-block: 1px solid var(--border);
    margin: 2.5rem auto 0;
  }
  .roadmap-stage {
    position: relative;
    display: grid;
    gap: .28rem;
    padding: 1.4rem 1.2rem 1.35rem;
  }
  .roadmap-stage:not(:last-child)::after {
    content: '';
    position: absolute;
    right: 0;
    top: 28%;
    width: 1px;
    height: 44%;
    background: var(--border);
  }
  .roadmap-number {
    font-family: ui-sans-serif, system-ui, sans-serif;
    color: var(--accent);
    font-size: .72rem;
    line-height: 1;
    letter-spacing: .14em;
    font-weight: 700;
  }
  .roadmap-label {
    color: var(--ink);
    font-size: 1.12rem;
    line-height: 1.2;
  }
  @media (max-width: 680px) {
    .article-roadmap { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .roadmap-stage:nth-child(2)::after { display: none; }
    .roadmap-stage:nth-child(-n+2) { border-bottom: 1px solid var(--border); }
    .roadmap-stage { padding: 1.1rem .9rem; }
  }
</style>
