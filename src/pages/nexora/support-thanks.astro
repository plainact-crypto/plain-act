---
const supportUrl = '/nexora/support/';
const documentationUrl = '/nexora/documentation/';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Support Request Sent | NEXORA Commerce</title>
  <style>
    :root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#e8edf3;background:#0b0f14;line-height:1.65}*{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;padding:24px;background:radial-gradient(circle at top right,#182332 0,#0b0f14 38rem);color:#e8edf3}.card{width:min(680px,100%);border:1px solid #263241;background:rgba(17,23,31,.9);border-radius:20px;padding:clamp(28px,6vw,52px)}.brand{font-size:.82rem;letter-spacing:.22em;text-transform:uppercase;color:#9ca9b8}h1{font-size:clamp(2.2rem,7vw,4.5rem);line-height:1;margin:.5rem 0 1rem;letter-spacing:-.04em}p{color:#b7c1cd}.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px}.button{display:inline-flex;align-items:center;min-height:44px;padding:10px 16px;border-radius:999px;background:#e8edf3;color:#0b0f14;text-decoration:none;font-weight:800}.button.secondary{border:1px solid #344357;background:transparent;color:#e8edf3}
  </style>
</head>
<body>
  <main class="card">
    <div class="brand">NEXORA Support</div>
    <h1>Request submitted.</h1>
    <p>Your support request has been handed to the form-delivery service. Keep any confirmation email for your records.</p>
    <p>If this is the first submission sent through the current support endpoint, NEXORA Support may need to confirm the recipient email before normal delivery begins.</p>
    <div class="actions">
      <a class="button" href={supportUrl}>Back to support</a>
      <a class="button secondary" href={documentationUrl}>Open documentation</a>
    </div>
  </main>
</body>
</html>
