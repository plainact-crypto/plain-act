---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site.js';

const base = import.meta.env.BASE_URL;
const href = (url) => `${base}${url.replace(/^\//, '')}`;

const resourcesSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Plain Act Management Tools & Resources',
  description: 'Free management tools, checklists, guides, and practical resources for first-time and working managers.',
  url: new URL(`${base}resources/`, site.siteUrl).toString(),
  publisher: { '@type': 'Organization', name: site.brand, url: site.fullUrl, email: site.email }
};

const tools = [
  {
    label: 'Plan your first month',
    title: 'New Manager 30-Day Planner',
    text: 'Build a four-week operating plan from team size, transition type, work model, current situation, and your main management focus.',
    link: href('/tools/new-manager-30-day-planner/'),
    detail: 'No signup · Local browser processing · Copy + print'
  },
  {
    label: 'Prepare a hard conversation',
    title: 'Difficult Conversation Planner',
    text: 'Turn observable behavior, impact, and the desired outcome into a neutral opening, question, expectation, next step, and follow-up brief.',
    link: href('/tools/difficult-conversation-planner/'),
    detail: 'No signup · No stored form data · Copy + print'
  },
  {
    label: 'Hand off work clearly',
    title: 'Delegation Brief Builder',
    text: 'Create a handoff with definition of done, owner, deadline, decision authority, constraints, checkpoints, escalation triggers, and confirmation question.',
    link: href('/tools/delegation-brief-builder/'),
    detail: 'No signup · Local browser processing · Copy + print'
  }
];
---

<BaseLayout
  title="Free Management Tools & Resources | Plain Act"
  description="Free Plain Act tools and resources for new managers: a 30-day planner, difficult-conversation planner, delegation brief builder, checklist, guide, and management framework."
  path="/resources/"
  current="Tools & Resources"
  schema={[resourcesSchema]}
>
  <section class="hero resources-hero">
    <div class="container grid grid-2">
      <div>
        <p class="eyebrow">Tools & Resources</p>
        <h1>Use something, not just read something.</h1>
        <p class="lede">Free management tools for planning a first month, preparing a difficult conversation, and delegating work clearly—plus the New Manager Guide, checklist, and Plain Act Method.</p>
        <div class="button-row"><a class="button" href="#tools">Use a free tool</a><a class="button secondary" href={href('/guides/new-manager/')}>Open the New Manager Guide</a></div>
      </div>
      <aside class="card flat resource-principle">
        <p class="eyebrow">Resource standard</p><h2>Every primary resource on this page is live.</h2>
        <p>No “coming soon” tool cards are counted as resources. The three interactive tools work without signup and process their form values in the browser page.</p>
        <p class="small">They provide general management guidance. They do not replace employer policy, legal/HR advice, or professional guidance when a situation requires it.</p>
      </aside>
    </div>
  </section>

  <section class="section" id="tools">
    <div class="container">
      <p class="eyebrow">Interactive tools</p><h2>Three practical builders.</h2>
      <div class="grid grid-3 tools-grid">
        {tools.map((tool, index) => (
          <article class="card tool-card">
            <span class="tool-number">0{index + 1}</span>
            <p class="eyebrow">{tool.label}</p><h3>{tool.title}</h3><p>{tool.text}</p><p class="small">{tool.detail}</p><p><a class="tool-link" href={tool.link}>Open tool →</a></p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-sm resource-band">
    <div class="container">
      <p class="eyebrow">Start here</p><h2>Core free management resources.</h2>
      <div class="grid grid-3">
        <article class="card flat"><h3>New Manager Guide</h3><p class="small">A substantial first-month pillar guide covering priorities, conversations, authority, delegation, feedback, meetings, boundaries, and decision timing.</p><p><a href={href('/guides/new-manager/')}>Read the guide →</a></p></article>
        <article class="card flat"><h3>First 30 Days Checklist</h3><p class="small">Twelve practical first-month actions you can use as a working checklist instead of a performance scorecard.</p><p><a href={href('/resources/new-manager-checklist/')}>Open checklist →</a></p></article>
        <article class="card flat"><h3>Plain Act Method</h3><p class="small">Notice pressure → Reduce reaction → Take one useful action → Stop, with worked examples, quick reference, and printable worksheet.</p><p><a href={href('/method/')}>Use the method →</a></p></article>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container grid grid-2">
      <div><p class="eyebrow">Problem library</p><h2>Prefer a focused article?</h2><p>Use the article directory for delegation, feedback, managing up, first team meetings, former peers, difficult conversations, authority, capacity, overexplaining, and week-one pressure.</p><div class="button-row"><a class="button secondary" href={href('/articles/')}>Browse all articles</a></div></div>
      <aside class="card flat"><h3>Useful path</h3><ol class="list-clean"><li>Start with the guide if you need the whole first-month picture.</li><li>Read a focused article for one management problem.</li><li>Use a tool or checklist to turn the idea into an action.</li><li>Use the Method when pressure is making the response bigger than the problem.</li></ol></aside>
    </div>
  </section>

  <section class="section-sm secondary-resources">
    <div class="container">
      <p class="eyebrow">Publishing & media</p><h2>Secondary resources.</h2>
      <div class="grid grid-3">
        <article class="card flat"><h3>Books</h3><p class="small">Plain Act's published management manuals and book information.</p><p><a href={href('/books/')}>View books</a></p></article>
        <article class="card flat"><h3>Press & media</h3><p class="small">Official publication details and media-use information.</p><p><a href={href('/press-kit/')}>Press Kit</a> · <a href={href('/media-bio/')}>Media Bio</a></p></article>
        <article class="card flat"><h3>Contact</h3><p class="small">Questions, corrections, media inquiries, or collaboration requests.</p><p><a href={`mailto:${site.email}`}>{site.email}</a></p></article>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .resources-hero h1{max-width:13ch}.resource-principle{align-self:stretch}.tools-grid{margin-top:1.4rem}.tool-card{position:relative;display:flex;flex-direction:column;min-height:360px}.tool-card .tool-number{position:absolute;right:1.2rem;top:1.1rem;color:#777;font-size:.8rem;font-weight:800;letter-spacing:.12em}.tool-card h3{font-size:1.55rem;max-width:13ch}.tool-card p:last-child{margin-top:auto}.tool-link{font-weight:800}.resource-band{border-top:1px solid var(--border);border-bottom:1px solid var(--border);background:#121416}.secondary-resources{border-top:1px solid var(--border)}
</style>
