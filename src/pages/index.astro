---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site.js';

const base = import.meta.env.BASE_URL;
const href = (url) => `${base}${url.replace(/^\//, '')}`;

const problems = [
  {
    label: 'Authority',
    title: 'Build authority without acting harsh',
    text: 'Create a steady pattern of decisions, boundaries, and follow-through without performing toughness.',
    url: '/articles/build-authority-as-new-manager/'
  },
  {
    label: 'Delegation',
    title: 'Delegate without micromanaging',
    text: 'Transfer ownership with a clear finish line, checkpoints, and escalation rules instead of taking the work back.',
    url: '/articles/delegate-without-micromanaging/'
  },
  {
    label: 'Feedback',
    title: 'Give feedback without killing morale',
    text: 'Address observable behavior early and clearly without turning the conversation into a lecture or apology.',
    url: '/articles/feedback-without-killing-morale/'
  },
  {
    label: 'Conflict',
    title: 'Handle difficult conversations earlier',
    text: 'Prepare the facts, impact, expectation, and next step before avoidance makes the issue more expensive.',
    url: '/articles/difficult-conversations-new-manager/'
  },
  {
    label: 'Former peers',
    title: 'Set boundaries after promotion',
    text: 'Keep warmth and trust while making the role change visible through consistent expectations and decisions.',
    url: '/articles/boundaries-former-peers/'
  },
  {
    label: 'First month',
    title: 'Know what to do in the first 30 days',
    text: 'Use a week-by-week path for listening, meetings, delegation, feedback, and decisions without rushing to fix everything.',
    url: '/articles/what-should-a-new-manager-do/'
  }
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Plain Act — Practical Management Guidance for New Managers',
  description: 'Free practical management guides, articles, resources, and books for first-time managers carrying authority under pressure.',
  url: site.fullUrl,
  publisher: { '@type': 'Organization', name: site.publisher, url: site.fullUrl }
};
---

<BaseLayout
  title="Plain Act | Practical Management Guidance for New Managers"
  description="Free practical management guides, articles, resources, and books for first-time managers carrying authority under pressure."
  path="/"
  current="Home"
  schema={[schema]}
>
  <section class="home-hero">
    <div class="container home-hero-grid">
      <div>
        <p class="eyebrow">Practical management for real pressure</p>
        <h1>Lead clearly before authority feels natural.</h1>
        <p class="lede">Plain Act helps first-time and working managers handle authority, delegation, feedback, difficult conversations, meetings, and decision pressure with calm, usable guidance.</p>
        <div class="button-row">
          <a class="button" href={href('/guides/new-manager/')}>Start the free New Manager Guide</a>
          <a class="button secondary" href={href('/articles/')}>Solve a management problem</a>
        </div>
        <ul class="home-proof" aria-label="What you can use on Plain Act">
          <li>Free long-form guide</li>
          <li>Practical articles</li>
          <li>Checklists & resources</li>
        </ul>
      </div>
      <aside class="home-hero-card" aria-label="Start here">
        <p class="eyebrow">Start here</p>
        <h2>New to management?</h2>
        <p>Begin with the pillar guide. It gives you a practical order for the first month instead of asking you to fix everything at once.</p>
        <a class="home-text-link" href={href('/guides/new-manager/')}>Open the New Manager Guide →</a>
      </aside>
    </div>
  </section>

  <section class="section home-start">
    <div class="container home-two-col">
      <div>
        <p class="eyebrow">New Manager Guide</p>
        <h2>A free path through the first month.</h2>
        <p class="lede">Use the guide to decide what deserves attention first: understanding the team, setting expectations, building trust, delegating work, giving feedback, and delaying changes until you have enough context.</p>
        <div class="button-row">
          <a class="button" href={href('/guides/new-manager/')}>Read the guide</a>
          <a class="button quiet" href={href('/resources/new-manager-checklist/')}>Open the checklist</a>
        </div>
      </div>
      <div class="home-mini-grid" aria-label="Guide outcomes">
        <article class="card flat"><strong>Week 1</strong><p>Listen, map the work, meet people, and avoid premature fixes.</p></article>
        <article class="card flat"><strong>Weeks 2–3</strong><p>Clarify expectations, delegation, meeting rhythm, and visible priorities.</p></article>
        <article class="card flat"><strong>Week 4</strong><p>Close loops, address recurring issues, and make the next month more deliberate.</p></article>
      </div>
    </div>
  </section>

  <section class="section home-problems">
    <div class="container">
      <div class="home-section-head">
        <div>
          <p class="eyebrow">Solve a problem</p>
          <h2>Go straight to the pressure you have now.</h2>
        </div>
        <a class="home-text-link" href={href('/articles/')}>Browse all articles →</a>
      </div>
      <div class="home-problem-grid">
        {problems.map((problem) => (
          <article class="home-problem-card">
            <p class="eyebrow">{problem.label}</p>
            <h3>{problem.title}</h3>
            <p>{problem.text}</p>
            <a href={href(problem.url)}>Read the practical guide →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section home-resources">
    <div class="container home-two-col">
      <div>
        <p class="eyebrow">Use a resource</p>
        <h2>Turn reading into a next action.</h2>
        <p class="lede">Plain Act resources are meant to help you prepare for work, not just read about it. Start with the New Manager Checklist, then use the resource hub to find the guide, Method, videos, and practical materials.</p>
        <div class="button-row">
          <a class="button" href={href('/resources/new-manager-checklist/')}>Use the free checklist</a>
          <a class="button secondary" href={href('/resources/')}>Explore Tools & Resources</a>
        </div>
      </div>
      <aside class="home-resource-card">
        <p class="eyebrow">Free resource</p>
        <h3>New Manager Checklist</h3>
        <p>A substantive checklist for the transition into management: people, expectations, communication, delegation, meetings, and early decisions.</p>
        <a href={href('/resources/new-manager-checklist/')}>Open checklist →</a>
      </aside>
    </div>
  </section>

  <section class="section home-method">
    <div class="container home-two-col">
      <div>
        <p class="eyebrow">Practical framework</p>
        <h2>Notice pressure. Reduce reaction. Take one useful action. Stop.</h2>
        <p class="lede">The Plain Act Method is a simple operating sequence for moments when pressure makes managers overexplain, rush, avoid, or take too much back onto themselves.</p>
        <a class="home-text-link" href={href('/method/')}>See the current Method →</a>
      </div>
      <ol class="home-method-list">
        <li><span>01</span><div><strong>Notice pressure</strong><p>Name what is making you rush, perform, avoid, or over-control.</p></div></li>
        <li><span>02</span><div><strong>Reduce reaction</strong><p>Remove the extra explanation, urgency, or emotion that does not improve the decision.</p></div></li>
        <li><span>03</span><div><strong>Take one useful action</strong><p>Choose the smallest clear action that moves the situation forward.</p></div></li>
        <li><span>04</span><div><strong>Stop</strong><p>Do not weaken a clear action by continuing to talk after the useful part is done.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="section home-book">
    <div class="container home-book-grid">
      <div>
        <p class="eyebrow">Go deeper</p>
        <h2>The First 30 Days as a New Manager</h2>
        <p class="lede">The book turns the same practical approach into a day-by-day manual for people carrying authority before it feels natural.</p>
        <p>Book promotion comes after the free guide, articles, and resources because the site should remain useful even if you never buy anything.</p>
        <div class="button-row">
          <a class="button" href={href('/books/the-first-30-days-as-a-new-manager/')}>View the book</a>
          <a class="button quiet" href={href('/books/')}>Browse books</a>
        </div>
      </div>
      <div class="home-book-visual">
        <img src={href('/assets/book-cover-first-30-days.jpg')} alt="Cover of The First 30 Days as a New Manager" width="520" height="780" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="section home-trust">
    <div class="container home-two-col">
      <div>
        <p class="eyebrow">Publishing & trust</p>
        <h2>Know who publishes the material and how it is handled.</h2>
        <p class="lede">Plain Act is published by {site.publisher}. The site separates practical editorial guidance from commercial pages and provides a clear route for questions and corrections.</p>
      </div>
      <div class="home-trust-links">
        <a href={href('/about/')}><strong>About Plain Act</strong><span>Publishing identity, purpose, and audience.</span></a>
        <a href={href('/editorial-policy/')}><strong>Editorial Policy</strong><span>Scope, originality, sources, AI-assisted production, updates, and commercial independence.</span></a>
        <a href={href('/corrections-policy/')}><strong>Corrections Policy</strong><span>How to report and handle material errors.</span></a>
        <a href={href('/contact/')}><strong>Contact</strong><span>{site.email}</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero{padding:clamp(4.5rem,8vw,7.5rem) 0 5rem;border-bottom:1px solid var(--border);background:radial-gradient(circle at 75% 12%,#2d3033 0,#1a1c1f 34%,#111315 72%)}
  .home-hero-grid,.home-two-col,.home-book-grid{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(300px,.8fr);gap:clamp(2rem,5vw,5rem);align-items:center}
  .home-hero h1{max-width:12ch}
  .home-hero-card,.home-resource-card{border:1px solid #3b3e42;border-radius:24px;padding:clamp(1.5rem,3vw,2.3rem);background:linear-gradient(180deg,rgba(255,255,255,.055),rgba(255,255,255,.025));box-shadow:var(--shadow)}
  .home-hero-card h2{font-size:clamp(1.8rem,3vw,2.6rem)}
  .home-proof{display:flex;flex-wrap:wrap;gap:.7rem 1.4rem;padding:0;margin:1.8rem 0 0;list-style:none;color:#bbb;font-size:.9rem}.home-proof li:before{content:'✓';color:var(--accent);margin-right:.5rem}
  .home-text-link{font-weight:800;text-decoration:none}
  .home-start,.home-resources,.home-book{background:#151719}
  .home-mini-grid{display:grid;gap:.8rem}.home-mini-grid .card{padding:1.2rem}.home-mini-grid strong{display:block;color:var(--accent);margin-bottom:.35rem}.home-mini-grid p{margin:0;color:#b7b6b1;font-size:.95rem}
  .home-section-head{display:flex;align-items:end;justify-content:space-between;gap:2rem;margin-bottom:1.6rem}.home-section-head h2{max-width:15ch}
  .home-problem-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.home-problem-card{border:1px solid #34373a;border-radius:20px;padding:1.35rem;background:#1a1d20}.home-problem-card h3{font-size:1.25rem}.home-problem-card p:not(.eyebrow){color:#aaa}.home-problem-card a{font-weight:700;text-decoration:none}
  .home-resource-card h3{font-size:1.6rem}.home-resource-card p{color:#b5b4af}
  .home-method-list{list-style:none;padding:0;margin:0;display:grid;gap:.8rem}.home-method-list li{display:grid;grid-template-columns:44px 1fr;gap:1rem;border-top:1px solid #393c40;padding:1rem 0}.home-method-list li:first-child{border-top:0}.home-method-list span{color:var(--accent);font-weight:800}.home-method-list strong{display:block;margin-bottom:.2rem}.home-method-list p{margin:0;color:#aaa;font-size:.94rem}
  .home-book-grid{grid-template-columns:minmax(0,1.15fr) minmax(220px,.55fr)}.home-book-visual{display:flex;justify-content:center}.home-book-visual img{width:min(320px,80%);border-radius:12px;border:1px solid #46494d;box-shadow:0 28px 65px rgba(0,0,0,.4)}
  .home-trust-links{display:grid;gap:.7rem}.home-trust-links a{display:grid;gap:.2rem;padding:1rem 1.1rem;border:1px solid #34373a;border-radius:16px;background:#191c1f;text-decoration:none}.home-trust-links strong{color:#f6f2e8}.home-trust-links span{color:#9fa1a3;font-size:.9rem}
  @media(max-width:900px){.home-hero-grid,.home-two-col,.home-book-grid{grid-template-columns:1fr}.home-problem-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.home-section-head{align-items:flex-start;flex-direction:column}.home-book-visual{justify-content:flex-start}}
  @media(max-width:620px){.home-problem-grid{grid-template-columns:1fr}.home-hero{padding-top:3.5rem}.home-proof{display:grid}.home-hero-card,.home-resource-card{border-radius:18px}.home-book-visual img{width:min(260px,76%)}}
</style>
